//——————————————— Top banner ———————————————
talk DecoTop@TopBanner@Talk
{
	{narrator}It's a bit frayed...{narratoroff}
}

talk DecoTop@TopBanner@Talk
{
	{narrator}"HAPPY PARTY", is it?{narratoroff}
}

talk DecoTop@TopBanner@Pet
{
	\0\s[annoyed]Stop messing with that, it was hard to hang up.
}

