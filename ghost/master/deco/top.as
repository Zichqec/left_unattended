//——————————————— Triangles ———————————————
talk DecoTop@TriangleString@Talk(p)
{
	\p[{p}]{narrator}Shiny triangles on a string... what are these things called?{narratoroff}
}

talk DecoTop@TriangleString@Pet(p)
{
	\s[eyeroll]\i[10]Yes, yes, they're very shiny. \s[annoyed]But if you keep putting your hands all over them, they won't be anymore.
}

talk DecoTop@TriangleString@Close(p)
{
	\p[{p}]\s[-1]\0\s[anger]Hey! Don't just pull my triangles down, they're a pain to put up there!
}


//——————————————— Top banner ———————————————
talk DecoTop@TopBanner@Talk(p)
{
	\p[{p}]{narrator}It's a bit frayed...{narratoroff}
}

talk DecoTop@TopBanner@Talk(p)
{
	\p[{p}]{narrator}"HAPPY PARTY", is it?{narratoroff}
}

talk DecoTop@TopBanner@Pet(p)
{
	\s[annoyed]Stop messing with that, it was hard to hang up.
}


//——————————————— Disco ball ———————————————
talk DecoTop@DiscoBall@Talk(p)
{
	\p[{p}]{narrator}It glimmers and gleams as it spins...{narratoroff}
}

talk DecoTop@DiscoBall@Pet(p)
{
	\s[annoyed]If you get your handprints all over the disco ball, it's not going to be shiny anymore!
}

talk DecoTop@DiscoBall@Pet(p)
{
	\s[annoyed]Stop messing with that disco ball, I don't have time to clean it if you get it dirty!
}


//——————————————— Light string ———————————————
talk DecoTop@TopLightString@Talk(p)
{
	\p[{p}]{narrator}If you squint and tilt your head a little, they look like terrifyingly huge lightning bugs...{narratoroff}
}

talk DecoTop@TopLightString@Talk(p)
{
	\p[{p}]{narrator}Tiny, burning suns, stabbing into the retinas of onlookers...{narratoroff}
}

talk DecoTop@TopLightString@Pet(p)
{
	\s[anger]They zapped me when I put them up there. I hope they zap you too for messing with my hard work!
}